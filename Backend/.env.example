# AgentGauntlet 环境配置示例 —— 复制为 .env 后按需修改
# PostgreSQL（复用焰哨实例，平台只写 gauntlet schema）
GAUNTLET_DSN=postgresql://postgres:postgres@localhost:5432/fire_agent
# 焰哨被测服务
GAUNTLET_YANSHAO_BASE_URL=http://127.0.0.1:8000
GAUNTLET_YANSHAO_USER=admin
GAUNTLET_YANSHAO_PASSWORD=20040716qazwsxEDCRFV!
# run 级 token 预算熔断
GAUNTLET_TOKEN_BUDGET=2000000
# judge LLM（dashscope 同源）
GAUNTLET_JUDGE_MODEL=qwen-max
